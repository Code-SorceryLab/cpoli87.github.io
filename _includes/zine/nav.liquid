{%- comment -%}
  Main menu. Labels match the section names used in the body.
  The CV is left out until it is finished.
{%- endcomment -%}
{%- assign here = page.url -%}
<nav class="nav" aria-label="Sections">
  <a
    href="{{ '/' | relative_url }}"
    {% if here == '/' %}
      aria-current="page"
    {% endif %}
    >Cover</a
  >
  <a
    href="{{ '/codex/' | relative_url }}"
    {% if here contains '/codex/' %}
      aria-current="page"
    {% endif %}
    >Codex</a
  >
  <a
    href="{{ '/quests/' | relative_url }}"
    {% if here contains '/quests/' %}
      aria-current="page"
    {% endif %}
    >Quests</a
  >
  <a
    href="{{ '/dispatches/' | relative_url }}"
    {% if here contains '/dispatches/' %}
      aria-current="page"
    {% endif %}
    >Dispatches</a
  >
  <a
    href="{{ '/party/' | relative_url }}"
    {% if here contains '/party/' %}
      aria-current="page"
    {% endif %}
    >Party</a
  >
  <a
    href="{{ '/training/' | relative_url }}"
    {% if here contains '/training/' %}
      aria-current="page"
    {% endif %}
    >Training</a
  >
</nav>
