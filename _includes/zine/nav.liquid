{%- comment -%}
  Main menu. Labels match the section names used in the body.
  The CV is left out until it is finished.
{%- endcomment -%}
{%- assign here = page.url -%}
<nav class="nav" aria-label="Sections">
  <a
    href="{{ '/' | relative_url }}"
    {% if here == '/' %}
      aria-current="page"
    {% endif %}
    >Cover</a
  >
  <a
    href="{{ '/publications/' | relative_url }}"
    {% if here contains '/publications/' %}
      aria-current="page"
    {% endif %}
    >Codex</a
  >
  <a
    href="{{ '/projects/' | relative_url }}"
    {% if here contains '/projects/' %}
      aria-current="page"
    {% endif %}
    >Quests</a
  >
  <a
    href="{{ '/blog/' | relative_url }}"
    {% if here contains '/blog/' %}
      aria-current="page"
    {% endif %}
    >Dispatches</a
  >
  <a
    href="{{ '/people/' | relative_url }}"
    {% if here contains '/people/' %}
      aria-current="page"
    {% endif %}
    >Party</a
  >
  <a
    href="{{ '/teaching/' | relative_url }}"
    {% if here contains '/teaching/' %}
      aria-current="page"
    {% endif %}
    >Training</a
  >
</nav>
