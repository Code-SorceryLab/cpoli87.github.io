---
layout: zine
---
{%- comment -%}
  Generic page and project page in the zine style.
  Projects (the `projects` collection) get a "Quest" kicker and prev/next.
{%- endcomment -%}
{%- assign is_project = false -%}
{%- if page.collection == 'projects' -%}{%- assign is_project = true -%}{%- endif -%}
{%- assign cat_names = 'llm npcs:LLM NPCs;playtesting agents:Playtesting agents;game software engineering:Game software engineering;engines and performance:Engines and performance;generative content:Generative content'
  | split: ';'
-%}
<article class="article">
  <header class="article-head">
    {% if is_project %}
      {%- assign name = page.category -%}
      {%- for pair in cat_names -%}
        {%- assign kv = pair | split: ':' -%}
        {%- if kv[0] == page.category -%}{%- assign name = kv[1] -%}{%- endif -%}
      {%- endfor -%}
      <div class="meta">
        Quest{% if name %} · {{ name }}{% endif %}
      </div>
    {% elsif page.kicker %}
      <div class="meta">{{ page.kicker }}</div>
    {% endif %}
    <h2 class="lino">{{ page.title }}</h2>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
  </header>
  <div class="prose">{{ content }}</div>
  {% if is_project %}
    {%- assign projects_page = site.pages | where: 'permalink', '/quests/' | first -%}
    {%- assign cats = projects_page.display_categories -%}
    {%- assign list = '' | split: '' -%}
    {%- for c in cats -%}
      {%- assign ps = site.projects | where: 'category', c | sort: 'importance' -%}
      {%- assign list = list | concat: ps -%}
    {%- endfor -%}
    {%- for p in list -%}
      {%- if p.url == page.url -%}{%- assign idx = forloop.index0 -%}{%- endif -%}
    {%- endfor -%}
    <div class="article-foot">
      <a class="btn ghost" href="{{ '/quests/' | relative_url }}">All quests</a>
      {% if idx %}
        {%- assign n = list | size -%}
        {%- assign pi = idx | minus: 1 -%}
        {%- if pi < 0 -%}{%- assign pi = n | minus: 1 -%}{%- endif -%}
        {%- assign ni = idx | plus: 1 -%}
        {%- if ni >= n -%}{%- assign ni = 0 -%}{%- endif -%}
        <span class="pair"
          ><a class="btn ghost" href="{{ list[pi].url | relative_url }}">Prev</a
          ><a class="btn ghost" href="{{ list[ni].url | relative_url }}">Next</a></span
        >
      {% endif %}
    </div>
  {% elsif page.back_url %}
    <div class="article-foot">
      <a class="btn ghost" href="{{ page.back_url }}">{{ page.back_label | default: 'Back' }}</a>
    </div>
  {% endif %}
</article>
