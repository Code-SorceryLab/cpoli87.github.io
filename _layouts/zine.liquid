<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include metadata.liquid %}
    <meta name="theme-color" content="#17141f">
    {% if site.icon.size <= 4 %}
      <link
        rel="shortcut icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
      >
    {% elsif site.icon != blank %}
      <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url }}">
    {% endif %}
    <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
    <link rel="alternate" type="application/atom+xml" title="Dispatches" href="{{ '/feed.xml' | relative_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=MedievalSharp&family=Archivo:ital,wght@1,700;1,800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=IBM+Plex+Mono:wght@400;600&display=swap"
    >
    <link rel="stylesheet" href="{{ '/assets/zine/zine.css' | relative_url | bust_file_cache }}">
  </head>
  <body class="zine">
    <a class="skip" href="#main">Skip to content</a>
    {% include zine/defs.liquid %}
    <div class="wrap">
      {% unless page.layout == 'cover' %}
        <a class="mini-head" href="{{ '/' | relative_url }}" aria-label="Code &amp; Sorcery Lab, back to the cover">
          <svg class="crest" viewBox="0 0 100 100" aria-hidden="true">
            <use href="#crest"/>
          </svg>
          <svg class="masthead" viewBox="0 0 300 66" aria-hidden="true">
            <use href="#masthead"/>
          </svg>
        </a>
        <p class="under lino">Empirical Game Research</p>
        {% include zine/nav.liquid %}
      {% endunless %}

      <main
        id="main"
        {% unless page.layout == 'cover' %}
          class="page-main"
        {% endunless %}
      >
        {{ content }}
      </main>

      <footer class="foot">
        <div class="printrun" role="group" aria-label="Spot ink for this issue">
          <span>Printed in</span>
          <button class="ink-btn" type="button" id="ink-ember" data-c="#e8962e" style="--c:#e8962e"><i></i>Ember</button>
          <button class="ink-btn" type="button" id="ink-steel" data-c="#9aa3ae" style="--c:#9aa3ae"><i></i>Steel</button>
          <button class="ink-btn" type="button" id="ink-coral" data-c="#e0625b" style="--c:#e0625b"><i></i>Coral</button>
          <button class="ink-btn" type="button" id="ink-woad" data-c="#5b98cf" style="--c:#5b98cf"><i></i>Woad</button>
        </div>
        <p class="colophon">
          &copy; {{ site.time | date: '%Y' }} Code &amp; Sorcery Lab · Ontario Tech University ·
          <a href="{{ '/feed.xml' | relative_url }}">RSS</a>
        </p>
      </footer>
    </div>
    <script src="{{ '/assets/zine/zine.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
