---
layout: zine
---
{%- comment -%} A blog post ("dispatch") in the zine style. {%- endcomment -%}
<article class="article">
  <header class="article-head">
    <div class="meta">
      Dispatch · <time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: '%-d %B %Y' }}</time>
    </div>
    <h2 class="lino">{{ page.title }}</h2>
    {% if page.description %}
      <p>{{ page.description }}</p>
    {% endif %}
    {% if page.author or page.authors %}
      <div class="by">By {% include zine/authors.liquid ids=page.author %}</div>
    {% endif %}
    {% if page.tags.size > 0 %}
      <div class="tags center-tags">
        {% for t in page.tags -%}
          <span>{{ t }}</span>
        {%- endfor %}
      </div>
    {% endif %}
  </header>
  <div class="prose">{{ content }}</div>
  <div class="article-foot">
    <a class="btn ghost" href="{{ '/blog/' | relative_url }}">All dispatches</a>
    <span class="pair">
      {% if page.next -%}
        <a class="btn ghost" href="{{ page.next.url | relative_url }}">Newer</a>
      {%- endif %}
      {% if page.previous -%}
        <a class="btn ghost" href="{{ page.previous.url | relative_url }}">Older</a>
      {%- endif %}
    </span>
  </div>
</article>
