---
---
{%- comment -%}
  jekyll-scholar template for one publication in the Codex.
  Used as: {% bibliography --template zine_bib %}
  The data-* attributes feed the filters and the character sheets.
{%- endcomment -%}
{%- capture venue -%}{%- if entry.type == 'article' -%}{{ entry.journal }}{%- else -%}{{ entry.booktitle }}{%- endif -%}{%- endcapture -%}
{%- capture authors_plain -%}{%- for a in entry.author_array -%}{{ a.first }} {{ a.last }}{%- unless forloop.last -%};{%- endunless -%}{%- endfor -%}{%- endcapture -%}
{%- capture link -%}{%- if entry.doi -%}https://doi.org/{{ entry.doi }}{%- elsif entry.url -%}{{ entry.url }}{%- endif -%}{%- endcapture -%}
<div
  class="pub"
  id="{{ entry.key }}"
  data-type="{{ entry.type }}"
  data-year="{{ entry.year }}"
  data-venue="{{ venue | strip | escape }}"
  data-abbr="{{ entry.abbr | escape }}"
  data-title="{{ entry.title | strip_html | escape }}"
  data-authors="{{ authors_plain | escape }}"
  data-link="{{ link | escape }}"
>
  <div class="vt">
    <span class="vt-short">
      {%- if entry.abbr %}{{ entry.abbr }}{% endif -%}</span
    ><i class="vt-kind"></i>
  </div>
  <div>
    <h4>
      {{ entry.title -}}
      {%- if entry.selected == 'true' -%}
        <span class="sel">Selected</span>
      {%- endif -%}
      {%- if entry.artifact == 'true' -%}
        <span class="sel">Artifact evaluated</span>
      {%- endif -%}
      {%- if entry.presentation -%}
        <span class="sel">{{ entry.presentation }}</span>
      {%- endif %}
    </h4>
    <p class="au">
      {%- for a in entry.author_array -%}
        <span class="a" data-n="{{ a.first }} {{ a.last }}">
          {%- if site.scholar.last_name contains a.last and site.scholar.first_name contains a.first -%}
            <mark>
              {{- a.first }}
              {{ a.last -}}
            </mark>
          {%- else -%}
            {{ a.first }}
            {{ a.last }}
          {%- endif -%}
        </span>
        {%- unless forloop.last -%}, {% endunless -%}
      {%- endfor -%}
    </p>
    <p class="ve">{{ venue | strip }}, {{ entry.year }}</p>
  </div>
  <div class="acts">
    {%- if entry.doi -%}
      <a class="btn" href="https://doi.org/{{ entry.doi }}">DOI</a>
    {%- elsif entry.url -%}
      <a class="btn" href="{{ entry.url }}">Link</a>
    {%- endif -%}
    {%- if entry.arxiv -%}
      <a class="btn ghost" href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>
    {%- endif -%}
    {%- if entry.pdf -%}
      <a
        class="btn ghost"
        href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}"
        >PDF</a
      >
    {%- endif -%}
    {%- if entry.code -%}
      <a class="btn ghost" href="{{ entry.code }}">Code</a>
    {%- endif -%}
  </div>
</div>
