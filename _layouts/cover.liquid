---
layout: zine
---
{%- comment -%}
  The home page: a pulp zine cover followed by the issue's sections.
  Welcome text comes from the page body (_pages/about.md); everything else
  is pulled from posts, projects, the bibliography and the people page.
{%- endcomment -%}
{%- assign projects_page = site.pages | where: 'permalink', '/quests/' | first -%}
{%- assign cats = projects_page.display_categories -%}
{%- assign all_posts = site.posts -%}

<section class="cover" id="home" aria-label="Cover">
  <div class="issue">
    <span
      >Issue <b>Nº {{ page.issue | default: 1 }}</b></span
    >
    <span>Ontario Tech University</span>
    <span>{{ site.time | date: '%B %Y' }}</span>
  </div>
  <svg class="crest" viewBox="0 0 100 100" role="img" aria-label="Code &amp; Sorcery crest">
    <use href="#crest"/>
  </svg>
  <h1 class="mast-h1">
    <svg class="masthead" viewBox="0 0 300 66" role="img" aria-label="Code &amp; Sorcery">
      <use href="#masthead"/>
    </svg>
  </h1>
  <p class="under lino">Empirical Game Research</p>
  {% include zine/nav.liquid %}

  <div class="cover-body">
    <figure class="photo">
      <div class="ink duo-frame">
        <img
          src="{{ page.cover_photo | default: 'assets/img/cover-portrait.jpg' | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          width="700"
          height="934"
        >
      </div>
      <figcaption>
        <b>
          {{- site.first_name }}
          {{ site.last_name -}}
        </b>
        {{- page.cover_caption }}
      </figcaption>
      <a class="seal" href="#guild"
        >The guild<br>
        is recruiting<br>
        ▸</a
      >
    </figure>
    <div class="welcome">
      <h2 class="lino">{{ page.welcome_title | default: 'Welcome, traveller' }}</h2>
      {{ content }}
      {% if page.areas %}
        <div class="areas">
          {% for a in page.areas -%}
            <span>{{ a }}</span>
          {%- endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="tales">
    <p class="label">Also in this issue · latest dispatches</p>
    <div class="tale-grid">
      {% for post in all_posts limit: 4 %}
        <a class="tale" href="{{ post.url | relative_url }}">
          <small>
            {{- post.date | date: '%b %Y' -}}
            {%- if post.tags.first %} · {{ post.tags.first }}{% endif -%}
          </small>
          <strong>{{ post.title }}</strong>
          {% if post.description -%}
            <span>{{ post.description }}</span>
          {%- endif %}
          <em>READ THE DISPATCH ▸</em>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="contents" aria-label="In this issue">
  <div class="sec-head"><h2 class="lino">In This Issue</h2></div>
  <div class="toc-wrap">
    <ul class="toc">
      {%- assign toc = 'Codex|/codex/|Every publication, searchable by title, author and venue.;Quests|/quests/|The research the lab is working on now.;Dispatches|/dispatches/|News, lectures, visits and notes from the lab.;The Party|/party/|Lab members and their character sheets.;The Guild Seeks Adventurers|#guild|Grad and undergrad positions in the lab.;The Training Grounds|/training/|Courses taught at Ontario Tech University.'
        | split: ';'
      -%}
      {%- for row in toc -%}
        {%- assign r = row | split: '|' -%}
        <li>
          <a href="{% if r[1] contains '#' %}{{ r[1] }}{% else %}{{ r[1] | relative_url }}{% endif %}"
            ><span class="ar" aria-hidden="true">▸</span>
            <div class="row">
              <span class="t">
                {%- if r[0] == 'Codex' %}The Codex{% else %}{{ r[0] }}{% endif -%}</span
              ><span class="lead"></span><span class="n">p. {{ forloop.index | times: 6 }}</span>
            </div>
            <div class="d">{{ r[2] }}</div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="codex" aria-label="The Codex">
  <div class="sec-head">
    <h2 class="lino">The Codex</h2>
    <p>A few of the lab's papers.</p>
  </div>
  <div class="codex">
    {% bibliography --template zine_bib_card --group_by none --query @*[selected=true]* %}
  </div>
  <div class="center"><a class="btn ghost" href="{{ '/codex/' | relative_url }}">Open the codex</a></div>
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="quests" aria-label="Quests">
  <div class="sec-head">
    <h2 class="lino">Quests</h2>
    <p>What the lab is working on now.</p>
  </div>
  <div class="quests">
    {%- assign featured = site.projects | where_exp: 'p', 'cats contains p.category' | sort: 'importance' -%}
    {% for p in featured limit: 6 %}
      {% include zine/quest_card.liquid project=p %}
    {% endfor %}
  </div>
  <div class="center"><a class="btn ghost" href="{{ '/quests/' | relative_url }}">All quests</a></div>
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="dispatches" aria-label="Dispatches">
  <div class="sec-head"><h2 class="lino">Dispatches</h2></div>
  <div class="dispatches">
    {% for post in all_posts offset: 4 limit: 4 %}
      <a class="card dispatch" href="{{ post.url | relative_url }}">
        <time datetime="{{ post.date | date: '%Y-%m-%d' }}">
          {{- post.date | date: '%b' | upcase -}}
          <br>
          {{ post.date | date: '%Y' -}}
        </time>
        <div>
          <h3>{{ post.title }}</h3>
          {% if post.description %}
            <p>{{ post.description }}</p>
          {% endif -%}
          <span class="go">Read</span>
        </div>
      </a>
    {% endfor %}
  </div>
  <div class="center"><a class="btn ghost" href="{{ '/dispatches/' | relative_url }}">All dispatches</a></div>
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="adventurers" aria-label="The Party">
  <div class="sec-head">
    <h2 class="lino">The Party</h2>
    <p>Some of the adventurers in the lab right now.</p>
  </div>
  <div class="roster" id="party-preview" data-count="4"></div>
  <div class="center"><a class="btn ghost" href="{{ '/party/' | relative_url }}">Meet the whole party</a></div>
  {% include zine/party_data.liquid %}
</section>

<svg class="sword" aria-hidden="true">
  <use href="#sword"/>
</svg>

<section class="sec" id="guild" aria-label="The Guild Seeks Adventurers">
  <div class="guild">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <use href="#crest"/>
    </svg>
    <h3 class="lino">The Guild Seeks Adventurers</h3>
    <div class="kick">Now recruiting</div>
    <ul>
      <li>Prospective MSc and PhD students</li>
      <li>Undergrads looking for a thesis project</li>
      <li>Researchers who want to collaborate</li>
    </ul>
    <a class="btn" href="{{ '/apply/grad-challenge/' | relative_url }}">Take the challenge</a>
  </div>
</section>

{% if page.next_issue %}
  <svg class="sword" aria-hidden="true">
    <use href="#sword"/>
  </svg>
  <section class="next" aria-label="Next issue">
    <h2 class="lino">Next Issue</h2>
    <ul>
      {% for item in page.next_issue %}
        <li>
          <b>{{ item.label }}:</b> {{ item.text }}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
