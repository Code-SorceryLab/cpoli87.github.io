  title = {A {{Survey}} of {{Video Game Testing}}},
  booktitle = {2021 {{IEEE}}/{{ACM International Conference}} on {{Automation}} of {{Software Test}} ({{AST}})},
  author = {Politowski, Cristiano and Petrillo, Fabio and Gueheneuc, Yann-Gael},
