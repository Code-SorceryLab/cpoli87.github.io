@misc{politowskiMigrationJavaScriptTypeScript2024,
  title = {Towards the {{Migration}} from {{JavaScript}} to {{TypeScript}}: {{Strategies}} and {{Quality Assessment}}},
  shorttitle = {Towards the {{Migration}} from {{JavaScript}} to {{TypeScript}}},
  author = {Politowski, Cristiano and El Boussaidi, Ghizlane and Costa, Diego Elias and Edouard, Jean-Baptiste},
  year = 2024,
  month = oct,
  publisher = {Zenodo},
  doi = {10.5281/ZENODO.13905691},
  urldate = {2024-10-23},
  abstract = {TypeScript (TS), a statically typed superset of JavaScript (JS), has gained popularity for enhancing software development through type safety and maintainability. This paper investigates how open-source JavaScript projects migrate to TypeScript and examines the impact of migration on project code quality. We analyzed 102 GitHub projects, tracking the evolution of file counts and code smells across their lifespans to answer two research questions: (1) How do projects migrate to TypeScript? and (2) Does code quality improve after migration? Our findings show that most projects transitioned to TypeScript suddenly, often without fully replacing JavaScript. We identified five migration strategies, ranging from sudden to gradual transitions, with varying levels of JS retention. Regarding code quality, half of the projects with sudden migration experienced a reduction in the number of issues. Issues related to variable and function scope decreased post-migration, while deprecation-related issues increased. The cognitive complexity of functions was the most prevalent issue during the migration, but most JavaScript-specific typing issues were reduced after switching to TypeScript. In conclusion, the studied projects exhibited a decrease in issues related to type safety and maintainability after migrating to TypeScript but also experienced new challenges such as increased cognitive complexity.},
  archiveprefix = {Zenodo},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {english},
  keywords = {/unread},
  file = {/home/cris/Zotero/storage/36VA59UK/Anon - 2024 - Towards the Migration from JavaScript to TypeScript Strategies and Quality Assessment.pdf}
}

